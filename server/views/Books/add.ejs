<%-include ../partials/header.ejs %>
<%-include ../partials/main_nav.ejs %>
<!--Content for adding the book-->
<div class="container">
    <div class="row">
        <div class="offset-md-3 col-md-6">
            <h1><%= title %></h1>
<!--Here are add our name.-->
            <form class="form" method="post">
                <div class="form-group">
                    <label for="nameTextField">Your name</label>
                    <input type="text" class="form-control"
                    id="nameTextField"
                    placeholder="Enter the book name"
                    name="name" required>
                </div>
<!--Here are add what course we're taking.-->
                <div class="form-group">
                    <label for="authorTextField">What course you're taking</label>
                    <input type="text" class="form-control"
                    id="authorTextField"
                    placeholder="Enter the author name"
                    name="author" required>
                </div>
<!--Here we add what year the student is in-->
                <div class="form-group">
                    <label for="publishedTextField">What year you are</label>
                    <input type="text" class="form-control"
                    id="publishedTextField"
                    placeholder="Enter the year of publication"
                    name="published" required>
                </div>
<!--Here we add what difficulites the student is experiencing in the course-->
                <div class="form-group">
                    <label for="descriptionTextArea">What difficulties you're having with the course</label>
                    <textarea type="text" class="form-control"
                    id="descriptionTextArea"
                    placeholder="Enter the brief description of the book"
                    name="description" required></textarea>
                <br>
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-edit"></i> Submit
                </button>
                <a href="/books" class="btn btn-warning">
                    <i class="fas fa-undo"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>
<%-include ../partials/footer.ejs %>